run_controller toggle
assert_log_prefix_count 3 \
  "hyprctl <dispatch> <movetoworkspacesilent> <special:wechat,address:"
assert_log_line \
  "hyprctl <dispatch> <movetoworkspacesilent> <special:wechat,address:0xmain>"
assert_log_line \
  "hyprctl <dispatch> <movetoworkspacesilent> <special:wechat,address:0xchild1>"
assert_log_line \
  "hyprctl <dispatch> <movetoworkspacesilent> <special:wechat,address:0xchild2>"
assert_no_log_line \
  "hyprctl <dispatch> <movetoworkspacesilent> <special:wechat,address:0xother>"
assert_log_prefix_count 0 "uwsm "
assert_json '
  all(.[] | select(((.class // "") | ascii_downcase) == "wechat");
    .workspace.name == "special:wechat")
  and (
    first(.[] | select(.address == "0xother") | .workspace.name)
    == "2"
  )
' "$STATE_DIR/clients.json"

# 3. A hidden main and children show together on the active workspace.
reset_state
set_clients <<'JSON'
[
