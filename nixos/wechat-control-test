set_activation_active_workspace <<'JSON'
{"id":9}
JSON
run_controller toggle
assert_log_line "$activation_command"
assert_log_prefix_count 0 "uwsm <app> <-t>"
assert_log_prefix_count 3 \
  "hyprctl <dispatch> <movetoworkspacesilent> <9,address:"
assert_log_line "hyprctl <dispatch> <focuswindow> <address:0xmain>"
assert_json '
  all(.[] | select(((.class // "") | ascii_downcase) == "wechat");
    .workspace.name == "9")
  and (
    first(.[] | select(.address == "0xother") | .workspace.name)
    == "4"
  )
' "$STATE_DIR/clients.json"

# 5. Closing the active main stops the complete fixed service.
reset_state
printf 'active\n' >"$STATE_DIR/service-state"
set_clients <<'JSON'
[
  {
    "address": "0xmain",
    "class": "wechat",
    "title": "Weixin",
    "initialTitle": "",
    "workspace": {"name": "7"}
  },
  {
    "address": "0xchild",
    "class": "wechat",
    "title": "Browser",
