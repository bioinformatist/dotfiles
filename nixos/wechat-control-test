# 6. Closing a WeChat child or a non-WeChat window retains killactive.
reset_state
set_active_window <<'JSON'
{
  "address": "0xchild",
  "class": "wechat",
  "title": "Browser",
  "initialTitle": "Browser"
}
JSON
run_controller close-active
assert_log_count 1 "hyprctl <dispatch> <killactive>"
assert_log_count 0 "systemctl <--user> <stop> <app-wechat.service>"

reset_state
set_active_window <<'JSON'
{
  "address": "0xother",
  "class": "firefox",
  "title": "Other",
  "initialTitle": "Other"
}
JSON
run_controller close-active
assert_log_count 1 "hyprctl <dispatch> <killactive>"
assert_log_count 0 "systemctl <--user> <stop> <app-wechat.service>"

# 8. Main-window recovery has a bounded, failing timeout.
reset_state
printf 'active\n' >"$STATE_DIR/service-state"
set_clients <<'JSON'
[
  {
    "address": "0xchild",
    "class": "wechat",
    "title": "Browser",
    "initialTitle": "Browser",
    "workspace": {"name": "special:wechat"}
  }
]
JSON
if run_controller toggle >"$STATE_DIR/timeout.stdout" 2>"$STATE_DIR/timeout.stderr"; then
  fail "child-only recovery unexpectedly succeeded without a main window"
fi
assert_log_line "$activation_command"
assert_log_prefix_count 0 \
  "hyprctl <dispatch> <movetoworkspacesilent>"
assert_log_prefix_count 0 "hyprctl <dispatch> <focuswindow>"

# 9. A held runtime lock makes a concurrent toggle a successful no-op.
reset_state
exec {HELD_LOCK_FD}>"$RUNTIME_DIR/wechat-control.lock"
flock -n "$HELD_LOCK_FD"
run_controller toggle
flock -u "$HELD_LOCK_FD"
exec {HELD_LOCK_FD}>&-
[[ ! -s $COMMAND_LOG ]] \
  || fail "locked toggle dispatched commands"

# Malformed snapshots and unknown actions must fail without fallback behavior.
reset_state
printf '{}\n' >"$STATE_DIR/clients.json"
if run_controller toggle >"$STATE_DIR/json.stdout" 2>"$STATE_DIR/json.stderr"; then
  fail "malformed clients JSON unexpectedly succeeded"
fi
assert_log_prefix_count 0 "uwsm "
assert_log_prefix_count 0 "hyprctl <dispatch>"

reset_state
if run_controller unknown >"$STATE_DIR/unknown.stdout" 2>"$STATE_DIR/unknown.stderr"; then
  fail "unknown action unexpectedly succeeded"
fi
[[ ! -s $COMMAND_LOG ]] \
  || fail "unknown action dispatched commands"

printf 'wechat-control regression: all simulated states passed\n'
