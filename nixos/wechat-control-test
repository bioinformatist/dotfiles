# 4. Child-only state activates the existing service, waits for a new main,
# refreshes the changed active workspace, and shows the complete window set.
reset_state
printf 'active\n' >"$STATE_DIR/service-state"
printf '{"id":5}\n' >"$STATE_DIR/active-workspace.json"
set_clients <<'JSON'
