    "workspace": {"name": "special:wechat"}
  },
  {
    "address": "0xother",
    "class": "firefox",
    "title": "Other",
    "initialTitle": "Other",
    "workspace": {"name": "4"}
  }
]
JSON
set_activation_clients <<'JSON'
[
  {
    "address": "0xmain",
    "class": "wechat",
    "title": "Weixin",
    "initialTitle": "Weixin",
    "workspace": {"name": "special:wechat"}
  },
  {
    "address": "0xchild1",
    "class": "wechat",
    "title": "Browser",
    "initialTitle": "Browser",
    "workspace": {"name": "special:wechat"}
  },
  {
    "address": "0xchild2",
    "class": "wechat",
    "title": "Dialog",
    "initialTitle": "Dialog",
    "workspace": {"name": "special:wechat"}
  },
  {
