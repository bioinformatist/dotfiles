;; ═══ Notifications Module ═══
;; Long-running SwayNC subscription: count, DND, center visibility, inhibition.

(deflisten notif-status
  :initial '{"count":0,"dnd":false,"visible":false,"inhibited":false}'
  `~/.config/eww/scripts/get-notifications`)

(defwidget notifications []
  (button
    :class "module-btn"
    :onclick "swaync-client --toggle-panel"
    :onrightclick "swaync-client --toggle-dnd"
    :tooltip {notif-status.dnd ? "Notifications: Do Not Disturb (right-click to disable)" :
              notif-status.inhibited ? "Notifications inhibited (right-click toggles DND)" :
              notif-status.visible ? "Notification center open (right-click toggles DND)" :
              "Notifications (left-click opens center; right-click toggles DND)"}
    (box :orientation "h"
         :space-evenly false
         :spacing 6
      (label
        :class {notif-status.dnd || notif-status.inhibited ? "icon-notif-dnd" :
                notif-status.visible || notif-status.count > 0 ? "icon-notif-active" :
                "icon-notif-idle"}
        :text  {notif-status.dnd || notif-status.inhibited ? "󰂛" :
                notif-status.visible || notif-status.count > 0 ? "󰂚" : "󰂜"})
      (label
        :class "module-value"
        :visible {notif-status.count > 0}
        :text "${notif-status.count}"))))
