;; Compact Clash Verge status. NetworkManager and Blueman controls live in the systray.

(defpoll proxy-status
  :interval "5s"
  :initial '{"active":false,"service":false,"tun":false,"tooltip":"Clash Verge inactive"}'
  `~/.config/eww/scripts/get-proxy-status`)

(defwidget proxy-status-widget []
  (button
    :class "module-btn proxy-status"
    :visible {proxy-status.active}
    :onclick "clash-verge &"
    :tooltip {proxy-status.tooltip}
    (label :class "icon-clash-on" :text "󱣻")))
