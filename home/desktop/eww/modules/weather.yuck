;; ═══ Weather (yr.no MET Norway API) ═══
;; Checks every five minutes and refreshes successful data after 30 minutes.
;; Location is selected manually through a safe Zenity prompt.

(defpoll weather_data :interval "300s"
  :initial '{"temp":"--","icon":"☁","city":"Set location","symbol":"","stale":false}'
  "scripts/get-weather")

(defwidget weather []
  (eventbox
    :class "weather-container"
    :onclick "~/.config/eww/scripts/search-weather &"
    :onrightclick "scripts/open-weather &"
    :tooltip {weather_data.stale ?
              "${weather_data.city} (stale) (Left-click to select location, Right-click for forecast)" :
              "${weather_data.city} (Left-click to select location, Right-click for forecast)"}
    (box :orientation "h"
         :space-evenly false
         :spacing 4
      (label :class "weather-icon" :text "${weather_data.icon}")
      (label :class "weather-temp" :text {weather_data.temp == "--" ? "--" : "${weather_data.temp}°C"}))))
