;; ═══ Power Module ═══
;; Opens the per-monitor power action popup.

(defwidget power [monitor_name monitor_id screen_index]
  (button
    :class "module-btn"
    :onclick "~/.config/eww/scripts/toggle-popup power '${monitor_name}' ${monitor_id} ${screen_index}"
    :tooltip "Power"
    (label
      :class "icon-power"
      :text "⏻")))
