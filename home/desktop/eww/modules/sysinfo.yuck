;; Compact CPU/RAM metrics from Eww and an optional custom GPU probe.

(defpoll gpu-status
  :interval "3s"
  :initial '{"present":false,"gpus":[]}'
  `~/.config/eww/scripts/get-sysinfo`)

(defwidget sysinfo []
  (box :class "sysinfo-container"
       :orientation "h"
       :space-evenly false
       :spacing 6
    (box :class "sysinfo-metric"
         :orientation "h"
         :space-evenly false
         :spacing 4
         :tooltip "CPU usage"
      (label :class "icon-cpu" :text "")
      (label :class "module-value sysval-cpu"
             :text "${round(EWW_CPU.avg, 0)}%"))

    (box :class "sysinfo-metric"
         :orientation "h"
         :space-evenly false
         :spacing 4
         :tooltip "Memory usage"
      (label :class "icon-ram" :text "󰍛")
      (label :class "module-value sysval-ram"
             :text "${round(EWW_RAM.used_mem_perc, 0)}%"))

    (box :class "sysinfo-metric"
         :orientation "h"
         :space-evenly false
         :spacing 4
         :visible {gpu-status.present}
         :tooltip {gpu-status.present ? "GPU usage (${gpu-status.gpus[0].vendor})" : "GPU telemetry unavailable"}
      (label :class "icon-gpu" :text "󰢮")
      (label :class "module-value sysval-gpu"
             :text {gpu-status.present ? "${gpu-status.gpus[0].util}%" : ""}))))
