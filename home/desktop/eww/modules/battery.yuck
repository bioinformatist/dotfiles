;; Battery module. Desktop hosts without a battery hide it automatically.

(defpoll battery-status
  :interval "30s"
  :initial '{"present":false,"percentage":0,"state":"unknown","icon":"󰂎","class":"icon-battery"}'
  `~/.config/eww/scripts/get-battery`)

(defpoll power-profile-status
  :interval "5s"
  :initial '{"available":false,"active":"","profiles":[],"degraded":""}'
  `~/.config/eww/scripts/get-power-profile`)

(defwidget battery-content []
  (box
    :orientation "h"
    :space-evenly false
    :spacing 6
    (label
      :class {battery-status.class}
      :text {battery-status.icon})
    (label
      :class "module-value"
      :text "${battery-status.percentage}%")))

(defwidget battery [monitor_name monitor_id screen_index]
  (box
    :visible {battery-status.present}
    :orientation "h"
    :space-evenly false
    (button
      :class "module-btn"
      :visible {power-profile-status.available}
      :onclick "~/.config/eww/scripts/toggle-popup profile '${monitor_name}' ${monitor_id} ${screen_index}"
      :tooltip "Battery ${battery-status.percentage}% · Profile: ${power-profile-status.active}"
      (battery-content))
    (box
      :visible {!power-profile-status.available}
      :tooltip "Battery ${battery-status.percentage}%"
      (battery-content))))
