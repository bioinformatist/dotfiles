;; ─── Polling Intervals Overview ─────────────────────────
;; Clock:        1s (time), 60s (date)
;; Weather:      300s checks with a 30-minute successful-cache TTL
;; Other:        Event-driven (buttons, clicks) — no background polls

;; ─── Phase 1: Foundation ────────────────────────────────
(include "./modules/workspaces.yuck")
(include "./modules/window-title.yuck")
(include "./modules/clock.yuck")
(include "./modules/weather.yuck")
(include "./modules/bar-center-extra.yuck")

;; ─── Phase 2: System Modules ───────────────────────────
(include "./modules/audio.yuck")
(include "./modules/battery.yuck")
(include "./modules/power.yuck")
(include "./modules/sysinfo.yuck")
(include "./modules/notifications.yuck")

;; ─── Windows ────────────────────────────────────────────
(include "./windows/bar.yuck")
(include "./windows/audio-popup.yuck")
(include "./windows/popup-closer.yuck")
(include "./windows/power-popup.yuck")
(include "./windows/profile-popup.yuck")
