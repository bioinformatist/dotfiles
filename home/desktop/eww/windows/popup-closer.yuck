;; One full-screen closer definition, instantiated beside any popup at runtime.

(defwidget popup-closer-content []
  (eventbox
    :hexpand true
    :vexpand true
    :onclick "~/.config/eww/scripts/close-popups --once &"
    (box :hexpand true :vexpand true)))

(defwindow popup-closer
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "center")
  :stacking "overlay"
  :focusable false
  :exclusive false
  :namespace "eww-closer"
  (popup-closer-content))
