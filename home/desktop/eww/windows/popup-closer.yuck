;; One full-screen closer definition, instantiated beside any popup at runtime.

(defwidget popup-closer-content [popup_type monitor_name monitor_id]
  (eventbox
    :onclick "~/.config/eww/scripts/toggle-popup ${popup_type} '${monitor_name}' ${monitor_id}"))

(defwindow popup-closer [popup_type monitor_name monitor_id]
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "center")
  :stacking "fg"
  :focusable false
  :exclusive false
  :namespace "eww-closer"
  (popup-closer-content
    :popup_type popup_type
    :monitor_name monitor_name
    :monitor_id monitor_id))
