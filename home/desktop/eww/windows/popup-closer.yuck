;; One full-screen closer definition, instantiated beside any popup at runtime.

(defwidget popup-closer-content [popup_type monitor_name monitor_id screen_index]
  (eventbox
    :hexpand true
    :vexpand true
    :onclick "~/.config/eww/scripts/toggle-popup --close ${popup_type} '${monitor_name}' ${monitor_id} ${screen_index}"
    (box :hexpand true :vexpand true)))

(defwindow popup-closer [popup_type monitor_name monitor_id screen_index]
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "center")
  :stacking "fg"
  :focusable false
  :exclusive false
  :namespace "eww-closer"
  (popup-closer-content
    :popup_type popup_type
    :monitor_name monitor_name
    :monitor_id monitor_id
    :screen_index screen_index))
