;; ═══ Weather Search Window ═══
;; Small popup with an input field to set the location.

(defwidget weather-search-content []
  (box :class "popup-panel weather-search-panel"
       :orientation "v"
       :space-evenly false
       :spacing 12
       :valign "center"
       :halign "center"

    (label :class "search-title" :text "SEARCH CITY")
    (input :class "search-input"
           :value ""
           :onaccept "~/.config/eww/scripts/search-weather {} &")
    (label :class "search-hint" :text "Press Enter to search")
))

(defwindow weather-search-popup [monitor_name monitor_id]
  :geometry (geometry :x "0px"
                      :y "52px"
                      :width "360px"
                      :anchor "top center")
  :stacking "overlay"
  :focusable "ondemand"
  :exclusive false
  :namespace "eww-popup"
  (weather-search-content))
