;; Compact power-profile selector, opened through the battery module.

(defwidget profile-popup-content []
  (box :class "popup-panel profile-panel"
       :orientation "v"
       :space-evenly false
       :spacing 10
    (box :class "popup-header"
         :orientation "h"
         :space-evenly false
         :spacing 10
      (label :class "popup-icon" :text "󰓅")
      (label :class "popup-title" :text "Power profile"))

    (box :class "profile-list"
         :orientation "v"
         :space-evenly false
         :spacing 4
      (for profile in {power-profile-status.profiles}
        (button
          :class {profile == power-profile-status.active ? "profile-btn profile-btn-active" : "profile-btn"}
          :onclick "~/.config/eww/scripts/set-power-profile '${profile}'"
          (box :orientation "h"
               :space-evenly false
               :spacing 8
            (label
              :class {profile == power-profile-status.active ? "profile-indicator profile-indicator-active" : "profile-indicator"}
              :text {profile == power-profile-status.active ? "●" : "○"})
            (label :class "profile-name" :text profile :halign "start" :hexpand true)))))

    (box
      :class "profile-degraded"
      :visible {power-profile-status.degraded != ""}
      :orientation "h"
      :space-evenly false
      :spacing 8
      (label :class "profile-degraded-icon" :text "󰀦")
      (label
        :class "profile-degraded-text"
        :text "Performance limited: ${power-profile-status.degraded}"
        :wrap true))))

(defwindow profile-popup [monitor_name monitor_id screen_index]
  :geometry (geometry :x "-16px"
                      :y "52px"
                      :width "300px"
                      :anchor "top right")
  :stacking "overlay"
  :focusable false
  :exclusive false
  :namespace "eww-popup"
  (profile-popup-content))
