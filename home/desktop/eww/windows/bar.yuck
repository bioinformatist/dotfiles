;; ═══ Bar Window Definitions ═══
;; manage-bars opens one runtime instance for every connected monitor.

(defwidget bar_widget [monitor_name monitor_id screen_index]
  (centerbox :orientation "h"
             :class "bar-inner"
    ;; ─── Left: Workspaces + Window Title ───
    (box :class "bar-left"
         :orientation "h"
         :space-evenly false
         :halign "start"
         :spacing 12
      (workspaces :monitor_id monitor_id)
      (window-title))

    ;; ─── Center: Clock + Weather ───
    (box :class "bar-center"
         :orientation "h"
         :space-evenly false
         :halign "center"
         :spacing 12
      (clock)
      (weather)
      (bar-center-extra))

    ;; ─── Right: System Modules ───
    (box :class "bar-right"
         :orientation "h"
         :space-evenly false
         :halign "end"
         :spacing 4
      (sysinfo)
      (label :class "separator" :text "│")
      (notifications)
      (systray :icon-size 18 :spacing 4 :space-evenly false)
      (battery :monitor_name monitor_name :monitor_id monitor_id :screen_index screen_index)
      (audio :monitor_name monitor_name :monitor_id monitor_id :screen_index screen_index)
      (power :monitor_name monitor_name :monitor_id monitor_id :screen_index screen_index))))

(defwindow bar [monitor_name monitor_id screen_index]
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "48px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar_widget :monitor_name monitor_name :monitor_id monitor_id :screen_index screen_index))
