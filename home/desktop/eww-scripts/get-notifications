#!/usr/bin/env bash
# Normalize SwayNC's subscription stream for Eww.

set -u

RECONNECT_DELAY="${RECONNECT_DELAY:-1}"

normalize_event() {
  jq -ce '
    select(type == "object")
    | {
        count: ((.count // 0) | tonumber? // 0),
        dnd: (.dnd == true),
        visible: (.visible == true),
        inhibited: (.inhibited == true)
      }
  '
}

main() {
  local event normalized

  printf '%s\n' '{"count":0,"dnd":false,"visible":false,"inhibited":false}'
  while true; do
    while IFS= read -r event; do
      if normalized=$(printf '%s\n' "$event" | normalize_event); then
        printf '%s\n' "$normalized"
      fi
    done < <(swaync-client --subscribe 2>/dev/null)
    sleep "$RECONNECT_DELAY"
  done
}

main "$@"
