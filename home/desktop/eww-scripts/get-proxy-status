#!/usr/bin/env bash

set -u

service_active=false
for unit in clash-verge clash-verge-service mihomo clash; do
  if systemctl --user is-active --quiet "$unit" 2>/dev/null ||
    systemctl is-active --quiet "$unit" 2>/dev/null; then
    service_active=true
    break
  fi
done

tun_active=false
if ip -o link show 2>/dev/null |
  awk -F': ' '{sub(/@.*/, "", $2); print $2}' |
  grep -qiE '^(mihomo|tun[0-9]*|utun[0-9]*|clash.*)$'; then
  tun_active=true
fi

if [ "$service_active" = true ] || [ "$tun_active" = true ]; then
  active=true
else
  active=false
fi

if [ "$service_active" = true ] && [ "$tun_active" = true ]; then
  tooltip="Clash Verge active · TUN connected"
elif [ "$service_active" = true ]; then
  tooltip="Clash Verge service active"
elif [ "$tun_active" = true ]; then
  tooltip="Mihomo/TUN link active"
else
  tooltip="Clash Verge inactive"
fi

jq -cn \
  --argjson active "$active" \
  --argjson service "$service_active" \
  --argjson tun "$tun_active" \
  --arg tooltip "$tooltip" \
  '{active: $active, service: $service, tun: $tun, tooltip: $tooltip}'
