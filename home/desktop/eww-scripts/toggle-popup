#!/usr/bin/env bash
# Usage: toggle-popup <audio|power|profile> <monitor_name> <monitor_id> <screen_index>

set -u

monitor_key() {
  local sanitized digest

  sanitized=$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_-' '-' | sed -E 's/-+/-/g; s/^-//; s/-$//')
  [ -n "$sanitized" ] || sanitized="monitor"
  digest=$(printf '%s' "$1" | sha256sum)
  digest=${digest%% *}
  printf '%s-%s\n' "$sanitized" "${digest:0:16}"
}

active_window_ids() {
  local windows

  windows=$(eww active-windows 2>/dev/null) || return 1
  [ -n "$windows" ] || return 0
  printf '%s\n' "$windows" | awk -F': ' '{print $1}'
}

rollback_pair() {
  local popup_id="$1"
  local closer_id="$2"
  local active id popup_present closer_present
  local _

  for _ in 1 2 3; do
    eww close "$popup_id" "$closer_id" 2>/dev/null || true
    active=$(active_window_ids) || continue
    popup_present=false
    closer_present=false
    while IFS= read -r id; do
      [ "$id" = "$popup_id" ] && popup_present=true
      [ "$id" = "$closer_id" ] && closer_present=true
    done <<< "$active"
    if [ "$popup_present" = false ] && [ "$closer_present" = false ]; then
      return 1
    fi
  done

  printf 'toggle-popup: failed to clean up incomplete popup pair\n' >&2
  return 1
}

main() {
  local usage='Usage: toggle-popup <type> <monitor_name> <monitor_id> <screen_index>'
  local type="${1:?$usage}"
  local monitor_name="${2:?$usage}"
  local monitor_id="${3:?$usage}"
  local screen_index="${4:?$usage}"
  local encoded popup_id closer_id active requested_active id
  local -a windows_to_close=()
  local -A active_after_close=()
  local -A final_active=()

  case "$type" in
    audio|power|profile) ;;
    *)
      printf 'toggle-popup: unknown popup type: %s\n' "$type" >&2
      return 1
      ;;
  esac

  case "$screen_index" in
    ''|*[!0-9]*)
      printf 'toggle-popup: screen index must be numeric: %s\n' "$screen_index" >&2
      return 1
      ;;
  esac

  case "$monitor_id" in
    ''|*[!0-9]*)
      printf 'toggle-popup: monitor ID must be numeric: %s\n' "$monitor_id" >&2
      return 1
      ;;
  esac

  encoded=$(monitor_key "$monitor_name")
  popup_id="popup-${type}-${encoded}"
  closer_id="closer-${type}-${encoded}"
  active=$(active_window_ids) || {
    printf 'toggle-popup: failed to query active Eww windows\n' >&2
    return 1
  }
  requested_active=false

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    case "$id" in
      popup-*|closer-*) windows_to_close+=("$id") ;;
    esac
    [ "$id" = "$popup_id" ] && requested_active=true
  done <<< "$active"

  if [ "${#windows_to_close[@]}" -gt 0 ]; then
    eww close "${windows_to_close[@]}" 2>/dev/null || true
  fi

  active=$(active_window_ids) || {
    printf 'toggle-popup: failed to verify closed Eww windows\n' >&2
    return 1
  }
  while IFS= read -r id; do
    [ -n "$id" ] && active_after_close["$id"]=1
  done <<< "$active"
  for id in "${windows_to_close[@]}"; do
    if [ -n "${active_after_close[$id]+present}" ]; then
      printf 'toggle-popup: failed to close prior window: %s\n' "$id" >&2
      return 1
    fi
  done

  [ "$requested_active" = false ] || return 0

  if ! eww open popup-closer \
    --id "$closer_id" \
    --screen "$screen_index"; then
    printf 'toggle-popup: failed to open popup closer\n' >&2
    rollback_pair "$popup_id" "$closer_id"
    return 1
  fi

  if ! eww open "${type}-popup" \
    --id "$popup_id" \
    --screen "$screen_index"; then
    printf 'toggle-popup: failed to open popup\n' >&2
    rollback_pair "$popup_id" "$closer_id"
    return 1
  fi

  active=$(active_window_ids) || {
    printf 'toggle-popup: failed to verify opened popup pair\n' >&2
    rollback_pair "$popup_id" "$closer_id"
    return 1
  }
  while IFS= read -r id; do
    [ -n "$id" ] && final_active["$id"]=1
  done <<< "$active"
  if [ -z "${final_active[$popup_id]+present}" ] ||
    [ -z "${final_active[$closer_id]+present}" ]; then
    printf 'toggle-popup: popup pair did not become active\n' >&2
    rollback_pair "$popup_id" "$closer_id"
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
