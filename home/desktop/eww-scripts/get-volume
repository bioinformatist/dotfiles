#!/usr/bin/env bash
# Resilient PipeWire/PulseAudio status listener with ALSA capture fallback.

set -u

RECONNECT_DELAY="${RECONNECT_DELAY:-2}"

first_percentage() {
  grep -oE '[0-9]+%' | head -n 1 | tr -d '%' || true
}

get_audio_status() {
  local sink_info source_info sink_mute_info source_mute_info
  local sink_pct source_pct sink_muted source_muted
  local default_source alsa_card alsa_capture alsa_pct

  sink_info=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null || true)
  source_info=$(pactl get-source-volume @DEFAULT_SOURCE@ 2>/dev/null || true)
  sink_mute_info=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null || true)
  source_mute_info=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null || true)

  sink_pct=$(printf '%s\n' "$sink_info" | first_percentage)
  source_pct=$(printf '%s\n' "$source_info" | first_percentage)
  sink_muted=false
  source_muted=false
  case "$sink_mute_info" in
    *yes*) sink_muted=true ;;
  esac
  case "$source_mute_info" in
    *yes*) source_muted=true ;;
  esac

  default_source=$(pactl get-default-source 2>/dev/null || true)
  alsa_card=$(pactl list sources 2>/dev/null | awk -v default_source="$default_source" '
    BEGIN { in_default = 0 }
    /^\tName: / {
      in_default = ($2 == default_source)
    }
    in_default && /^\t\talsa.card = / {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' || true)

  if [ -n "$alsa_card" ] && command -v amixer >/dev/null 2>&1; then
    alsa_capture=$(amixer -c "$alsa_card" sget Capture 2>/dev/null || true)
    alsa_pct=$(printf '%s\n' "$alsa_capture" | first_percentage)
    if [ -n "$alsa_pct" ]; then
      source_pct=$alsa_pct
      case "$alsa_capture" in
        *'[off]'*) source_muted=true ;;
        *) source_muted=false ;;
      esac
    fi
  fi

  sink_pct=${sink_pct:-0}
  source_pct=${source_pct:-0}
  case "$sink_pct" in
    *[!0-9]*) sink_pct=0 ;;
  esac
  case "$source_pct" in
    *[!0-9]*) source_pct=0 ;;
  esac

  jq -cn \
    --argjson sink_vol "$sink_pct" \
    --argjson sink_muted "$sink_muted" \
    --argjson source_vol "$source_pct" \
    --argjson source_muted "$source_muted" \
    '{
      sink_vol:$sink_vol,
      sink_muted:$sink_muted,
      source_vol:$source_vol,
      source_muted:$source_muted
    }'
}

main() {
  local event

  while true; do
    if pactl info >/dev/null 2>&1; then
      get_audio_status
      while IFS= read -r event; do
        if [[ "$event" =~ ^Event\ \'(change|new|remove)\'\ on\ (sink|source|card|server)([[:space:]]|$) ]]; then
          get_audio_status
        fi
      done < <(pactl subscribe 2>/dev/null)
    fi
    sleep "$RECONNECT_DELAY"
  done
}

main "$@"
