#!/usr/bin/env bash
# Bounded MET weather refresh with a 30-minute successful-cache TTL.

set -u

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/eww"
LOCATION_CACHE="${EWW_WEATHER_LOCATION_CACHE:-$CACHE_DIR/weather_location.json}"
WEATHER_CACHE="${EWW_WEATHER_DATA_CACHE:-$CACHE_DIR/weather_data.json}"
FORCE_REFRESH="${EWW_WEATHER_FORCE_REFRESH:-0}"
FRESH_SECONDS=1800
TEMP_CACHE=""

mkdir -p "$CACHE_DIR"

cleanup() {
  if [ -n "$TEMP_CACHE" ]; then
    rm -f "$TEMP_CACHE"
  fi
}
trap cleanup EXIT

valid_location() {
  jq -e '
    type == "object"
    and ((.lat | tonumber?) != null)
    and ((.lon | tonumber?) != null)
    and (.city | type == "string" and length > 0)
  ' "$1" >/dev/null 2>&1
}

valid_weather_cache() {
  jq -e '
    type == "object"
    and (.temp | type == "number" or type == "string")
    and (.icon | type == "string" and length > 0)
    and (.city | type == "string")
    and (.symbol | type == "string")
  ' "$1" >/dev/null 2>&1
}

placeholder() {
  local city="${1:-Set location}"

  jq -cn --arg city "$city" \
    '{temp:"--", icon:"☁", city:$city, symbol:"", stale:false}'
}

stale_fallback() {
  local city="$1"

  if [ -f "$WEATHER_CACHE" ] && valid_weather_cache "$WEATHER_CACHE"; then
    jq -c '. + {stale:true}' "$WEATHER_CACHE"
  else
    placeholder "$city"
  fi
}

if [ ! -f "$LOCATION_CACHE" ] || ! valid_location "$LOCATION_CACHE"; then
  placeholder "Set location"
  exit 0
fi

LAT=$(jq -r '.lat' "$LOCATION_CACHE")
LON=$(jq -r '.lon' "$LOCATION_CACHE")
CITY=$(jq -r '.city' "$LOCATION_CACHE")

if [ "$FORCE_REFRESH" != 1 ] &&
  [ -f "$WEATHER_CACHE" ] &&
  valid_weather_cache "$WEATHER_CACHE"; then
  NOW=$(date +%s)
  CACHE_MTIME=$(stat -c %Y "$WEATHER_CACHE" 2>/dev/null || printf '0')
  CACHE_AGE=$((NOW - CACHE_MTIME))
  if [ "$CACHE_AGE" -ge 0 ] && [ "$CACHE_AGE" -lt "$FRESH_SECONDS" ]; then
    jq -c '. + {stale:false}' "$WEATHER_CACHE"
    exit 0
  fi
fi

if ! WEATHER=$(curl -sf \
  --connect-timeout 5 \
  --max-time 15 \
  --retry 0 \
  -H "User-Agent: eww-weather/1.1 github.com/bioinformatist/dotfiles" \
  "https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=$LAT&lon=$LON"); then
  stale_fallback "$CITY"
  exit 0
fi

if ! printf '%s\n' "$WEATHER" | jq -e '
  (.properties.timeseries | type == "array" and length > 0)
  and (.properties.timeseries[0].data.instant.details.air_temperature | type == "number")
' >/dev/null 2>&1; then
  stale_fallback "$CITY"
  exit 0
fi

TEMP=$(printf '%s\n' "$WEATHER" | jq -r '
  .properties.timeseries[0].data.instant.details.air_temperature | round')

SYMBOL=$(printf '%s\n' "$WEATHER" | jq -r '
  .properties.timeseries[0].data.next_1_hours.summary.symbol_code //
  .properties.timeseries[0].data.next_6_hours.summary.symbol_code //
  "unknown"')

case "$SYMBOL" in
  clearsky_*) ICON="☀" ;;
  fair_*|partlycloudy_*) ICON="⛅" ;;
  cloudy) ICON="☁" ;;
  *rain*) ICON="☂" ;;
  *snow*|*sleet*) ICON="❄" ;;
  fog) ICON="≋" ;;
  *thunder*) ICON="⚡" ;;
  *) ICON="☁" ;;
esac

RESULT=$(jq -cn \
  --argjson temp "$TEMP" \
  --arg icon "$ICON" \
  --arg city "$CITY" \
  --arg symbol "$SYMBOL" \
  '{temp:$temp, icon:$icon, city:$city, symbol:$symbol, stale:false}')

TEMP_CACHE=$(mktemp "$CACHE_DIR/.weather_data.XXXXXX") || {
  stale_fallback "$CITY"
  exit 0
}
printf '%s\n' "$RESULT" > "$TEMP_CACHE"
if ! valid_weather_cache "$TEMP_CACHE"; then
  stale_fallback "$CITY"
  exit 0
fi
mv -f "$TEMP_CACHE" "$WEATHER_CACHE"
TEMP_CACHE=""
printf '%s\n' "$RESULT"
