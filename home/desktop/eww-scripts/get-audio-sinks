#!/usr/bin/env bash
# ═══ List Audio Sinks (Output Devices) ═══
# Returns JSON array of output devices with id, name, active status.
# Dummy/null sinks are excluded; physical HDMI sinks remain eligible.

set -u

DEFAULT_SINK=$(pactl get-default-sink 2>/dev/null | tr -d '[:space:]')

if ! sinks=$(pactl --format=json list sinks 2>/dev/null); then
  jq -cn '[]'
  exit 0
fi

jq -c --arg default_sink "$DEFAULT_SINK" '
  def normalized_text:
    [
      (.name // ""),
      (.description // ""),
      (.driver // ""),
      (.properties["device.description"] // ""),
      (.properties["device.class"] // ""),
      (.properties["factory.name"] // ""),
      (.properties["node.name"] // "")
    ]
    | join(" ")
    | ascii_downcase;
  def is_dummy:
    (normalized_text) as $text
    | ($text | test("(^|[ ._/-])(auto[._-]?null|dummy([ ._-]+output)?|null[ ._-]+sink|support[ ._-]+null[ ._-]+audio[ ._-]+sink)([ ._/-]|$)"))
      or ((.properties["device.class"] // "" | ascii_downcase) == "abstract")
      or ((.driver // "" | ascii_downcase) | contains("module-null-sink"));
  map(select(is_dummy | not))
  | map({
      id: (.index | tostring),
      name: (.description // .name),
      active: (.name == $default_sink)
    })
' <<< "$sinks"
