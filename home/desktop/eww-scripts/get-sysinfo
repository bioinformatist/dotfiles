#!/usr/bin/env bash
# GPU-only telemetry probe. CPU and RAM come from Eww magic variables.

set -u

# Prefer NVIDIA's query interface, then fall back to AMD DRM sysfs.
if GPU_DATA=$(nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total \
  --format=csv,noheader,nounits 2>/dev/null) && [ -n "$GPU_DATA" ]; then
  GPU_JSON=$(printf '%s\n' "$GPU_DATA" | while IFS=', ' read -r idx util mem_used mem_total; do
    mem_pct=$(awk "BEGIN {printf \"%d\", (($mem_total > 0) ? $mem_used*100/$mem_total : 0)}")
    jq -cn \
      --argjson idx "$idx" \
      --arg vendor "NVIDIA" \
      --argjson util "$util" \
      --argjson mem_used "$mem_used" \
      --argjson mem_total "$mem_total" \
      --argjson mem_pct "$mem_pct" \
      '{idx: $idx, vendor: $vendor, util: $util, mem_used: $mem_used, mem_total: $mem_total, mem_pct: $mem_pct}'
  done | jq -s '.')
else
  GPU_JSON=$(
    idx=0
    for device in /sys/class/drm/card*/device; do
      [ -e "$device/vendor" ] || continue

      card=$(basename "$(dirname "$device")")
      case "$card" in
        card*[!0-9]*) continue ;;
      esac

      vendor=$(cat "$device/vendor" 2>/dev/null || true)
      [ "$vendor" = "0x1002" ] || continue
      [ -r "$device/gpu_busy_percent" ] || continue

      util=$(cat "$device/gpu_busy_percent" 2>/dev/null || printf '0')
      case "$util" in
        ''|*[!0-9]*) util=0 ;;
      esac

      mem_used=0
      mem_total=0
      if [ -r "$device/mem_info_vram_used" ]; then
        mem_used=$(($(cat "$device/mem_info_vram_used" 2>/dev/null || printf '0') / 1024 / 1024))
      fi
      if [ -r "$device/mem_info_vram_total" ]; then
        mem_total=$(($(cat "$device/mem_info_vram_total" 2>/dev/null || printf '0') / 1024 / 1024))
      fi
      mem_pct=$(awk "BEGIN {printf \"%d\", (($mem_total > 0) ? $mem_used*100/$mem_total : 0)}")

      jq -cn \
        --argjson idx "$idx" \
        --arg vendor "AMD" \
        --argjson util "$util" \
        --argjson mem_used "$mem_used" \
        --argjson mem_total "$mem_total" \
        --argjson mem_pct "$mem_pct" \
        '{idx: $idx, vendor: $vendor, util: $util, mem_used: $mem_used, mem_total: $mem_total, mem_pct: $mem_pct}'
      idx=$((idx + 1))
    done | jq -s '.'
  )
fi

jq -cn \
  --argjson gpus "${GPU_JSON:-[]}" \
  '{present: ($gpus | length > 0), gpus: $gpus}'
