#!/usr/bin/env bash
# Zenity-driven, transactional manual weather-location update.

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/eww"
LOCATION_CACHE="$CACHE_DIR/weather_location.json"
WEATHER_CACHE="$CACHE_DIR/weather_data.json"
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
GET_WEATHER="${EWW_GET_WEATHER:-$SCRIPT_DIR/get-weather}"
LOCATION_TMP=""
WEATHER_TMP=""

mkdir -p "$CACHE_DIR"

cleanup() {
  [ -z "$LOCATION_TMP" ] || rm -f "$LOCATION_TMP"
  [ -z "$WEATHER_TMP" ] || rm -f "$WEATHER_TMP"
}
trap cleanup EXIT

fail() {
  local message="$1"

  notify-send --urgency=normal "Weather update failed" "$message" 2>/dev/null || true
  printf 'search-weather: %s\n' "$message" >&2
  exit 1
}

if [ "$#" -gt 0 ]; then
  QUERY=$1
else
  if ! QUERY=$(zenity --entry \
    --title="Weather location" \
    --text="Enter a city or place" \
    --ok-label="Update" 2>/dev/null); then
    exit 0
  fi
fi

[ -n "$QUERY" ] || exit 0

if ! RESPONSE=$(curl -sfG \
  --connect-timeout 5 \
  --max-time 15 \
  --retry 0 \
  --data-urlencode "q=$QUERY" \
  --data-urlencode "format=json" \
  --data-urlencode "limit=1" \
  -H "User-Agent: eww-weather-search/1.0 github.com/bioinformatist/dotfiles" \
  "https://nominatim.openstreetmap.org/search"); then
  fail "Location lookup failed. Your previous weather is unchanged."
fi

if ! DATA=$(printf '%s\n' "$RESPONSE" | jq -ce '
  if type == "array" and length > 0
     and ((.[0].lat | tonumber?) != null)
     and ((.[0].lon | tonumber?) != null)
     and (.[0].display_name | type == "string" and length > 0)
  then .[0] | {
    lat: (.lat | tonumber),
    lon: (.lon | tonumber),
    city: (.display_name | split(",")[0])
  }
  else empty
  end
'); then
  fail "No matching location was found. Your previous weather is unchanged."
fi

LOCATION_TMP=$(mktemp "$CACHE_DIR/.weather_location.XXXXXX") || fail "Could not stage location data."
printf '%s\n' "$DATA" > "$LOCATION_TMP"

WEATHER_TMP=$(mktemp "$CACHE_DIR/.weather_data.XXXXXX") || fail "Could not stage weather data."
rm -f "$WEATHER_TMP"

if ! UPDATED_WEATHER=$(
  EWW_WEATHER_LOCATION_CACHE="$LOCATION_TMP" \
    EWW_WEATHER_DATA_CACHE="$WEATHER_TMP" \
    EWW_WEATHER_FORCE_REFRESH=1 \
    bash "$GET_WEATHER"
) || [ ! -f "$WEATHER_TMP" ]; then
  fail "Weather refresh failed. Your previous location and weather are unchanged."
fi

if ! jq -e '
  type == "object"
  and (.temp | type == "number" or type == "string")
  and (.icon | type == "string" and length > 0)
  and (.city | type == "string" and length > 0)
  and (.symbol | type == "string")
' "$WEATHER_TMP" >/dev/null 2>&1; then
  fail "Weather data was invalid. Your previous location and weather are unchanged."
fi

mv -f "$WEATHER_TMP" "$WEATHER_CACHE"
WEATHER_TMP=""
mv -f "$LOCATION_TMP" "$LOCATION_CACHE"
LOCATION_TMP=""

eww update weather_data="$UPDATED_WEATHER" 2>/dev/null || true
CITY=$(printf '%s\n' "$DATA" | jq -r '.city')
notify-send --urgency=normal "Weather updated" "Location set to: $CITY" 2>/dev/null || true
