#!/usr/bin/env bash
# Close active Eww popup instances when focus moves to another application.

set -u

HYPR_SOCKET=""
RECONNECT_DELAY="${RECONNECT_DELAY:-1}"

wait_for_dependencies() {
  local signature
  local _

  for _ in $(seq 1 60); do
    signature=${HYPRLAND_INSTANCE_SIGNATURE:-}
    if [ -n "$signature" ]; then
      HYPR_SOCKET="${XDG_RUNTIME_DIR:?}/hypr/$signature/.socket2.sock"
      if [ -S "$HYPR_SOCKET" ] && eww active-windows >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 0.2
  done

  printf 'close-popups: Eww or Hyprland did not become ready\n' >&2
  return 1
}

close_all_popups() {
  local id windows
  local -a active_ids=()

  windows=$(eww active-windows 2>/dev/null) || return 1
  while IFS= read -r id; do
    case "$id" in
      popup-*|closer-*) active_ids+=("$id") ;;
    esac
  done < <(printf '%s\n' "$windows" | awk -F': ' '{print $1}')

  if [ "${#active_ids[@]}" -gt 0 ]; then
    eww close "${active_ids[@]}" 2>/dev/null || true
  fi
}

listen_once() {
  local line win_class

  while IFS= read -r line; do
    case "$line" in
      activewindow\>\>*)
        win_class=${line#activewindow>>}
        win_class=${win_class%%,*}
        if [ -n "$win_class" ] && [ "$win_class" != "eww" ]; then
          close_all_popups || true
        fi
        ;;
    esac
  done < <(socat -u "UNIX-CONNECT:${HYPR_SOCKET}" - 2>/dev/null)
}

main() {
  wait_for_dependencies || return 1

  while true; do
    listen_once
    sleep "$RECONNECT_DELAY"
  done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
