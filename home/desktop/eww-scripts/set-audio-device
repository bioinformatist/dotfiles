#!/usr/bin/env bash
# ═══ Set Default Audio Device ═══
# Usage: set-audio-device sink|source <numeric_pactl_id>

set -u

fail() {
  local message="$1"
  printf 'set-audio-device: %s\n' "$message" >&2
  dunstify -u critical "Audio device change failed" "$message" 2>/dev/null || true
  exit 1
}

[ "$#" -eq 2 ] || fail "Usage: set-audio-device <sink|source> <numeric pactl id>"

DIRECTION="$1"
DEVICE_ID="$2"

case "$DIRECTION" in
  sink|source) ;;
  *) fail "Unknown device type: $DIRECTION" ;;
esac

case "$DEVICE_ID" in
  ''|*[!0-9]*) fail "Device ID must be numeric: $DEVICE_ID" ;;
esac

if [ "$DIRECTION" = "sink" ]; then
  if ! output=$(pactl set-default-sink "$DEVICE_ID" 2>&1); then
    fail "Could not select output $DEVICE_ID: ${output:-pactl failed}"
  fi
elif ! output=$(pactl set-default-source "$DEVICE_ID" 2>&1); then
  fail "Could not select input $DEVICE_ID: ${output:-pactl failed}"
fi
