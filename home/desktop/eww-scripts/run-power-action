#!/usr/bin/env bash
# ═══ Eww Power Action Runner ═══
# Closes the active power popup, then executes the requested action.

set -eu

ACTION="${1:?Usage: run-power-action <logout|poweroff|reboot>}"

mapfile -t POWER_WINDOWS < <(
  eww active-windows 2>/dev/null |
    awk -F': ' '$1 ~ /^(popup|closer)-power-/ {print $1}'
)
if [ "${#POWER_WINDOWS[@]}" -gt 0 ]; then
  eww close "${POWER_WINDOWS[@]}" 2>/dev/null || true
fi

case "$ACTION" in
  logout)
    exec uwsm stop
    ;;
  poweroff|reboot)
    exec systemctl --user start --no-block "dotfiles-power-action@${ACTION}.service"
    ;;
  *)
    echo "Unknown power action: $ACTION" >&2
    exit 1
    ;;
esac
