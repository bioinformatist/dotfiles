#!/usr/bin/env bash
# Set a daemon-reported power profile.

set -u

SERVICE="net.hadess.PowerProfiles"
OBJECT="/net/hadess/PowerProfiles"
INTERFACE="net.hadess.PowerProfiles"
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ACTIVE_SESSION_MARKER="EWW_POWER_PROFILE_ACTIVE_SESSION"

notify_failure() {
  notify-send --urgency=critical "Power profiles" "$1" >/dev/null 2>&1 || true
}

dispatch_to_active_session() {
  local requested="$1"
  local command output

  if ! command -v hyprctl >/dev/null 2>&1; then
    notify_failure "Hyprland control is unavailable"
    return 1
  fi

  printf -v command 'env %s=1 bash %q %q' "$ACTIVE_SESSION_MARKER" "$0" "$requested"
  if ! output=$(hyprctl dispatch exec -- "$command" 2>&1); then
    notify_failure "Failed to request $requested: $output"
    return 1
  fi
}

main() {
  local requested="${1:?Usage: set-power-profile <profile>}"
  local state available output

  state=$(bash "$SCRIPT_DIR/get-power-profile") || return 1
  available=$(jq -r '.available' <<< "$state") || return 1
  if [ "$available" != true ]; then
    notify_failure "power-profiles-daemon is unavailable"
    return 1
  fi
  if ! jq -e --arg requested "$requested" \
    '.profiles | index($requested) != null' <<< "$state" >/dev/null; then
    notify_failure "Unknown power profile: $requested"
    return 1
  fi

  if [ "${EWW_POWER_PROFILE_ACTIVE_SESSION:-0}" != 1 ]; then
    dispatch_to_active_session "$requested"
    return
  fi

  if ! output=$(busctl --system --no-pager --auto-start=false set-property \
    "$SERVICE" "$OBJECT" "$INTERFACE" ActiveProfile s "$requested" 2>&1); then
    notify_failure "Failed to set $requested: $output"
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
